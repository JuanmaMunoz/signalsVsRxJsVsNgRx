{
  "name": "signalsVsRxJsVsNgRx",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run lint && npm run test",
    "build": "ng build --configuration production --base-href https://juanmamunoz.github.io/signalsVsRxJsVsNgRx/ && xcopy docs\\browser docs /E /H /Y && rmdir /S /Q docs\\browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage --browsers=ChromeHeadless --watch=false",
    "test:dev": "ng test --code-coverage --browsers=ChromeHeadless",
    "lint": "ng lint"
  },
  "private": true,
